# --- ضروری ---
BOT_TOKEN=
GEMINI_API_KEY=

# مدل Gemini (در صورت تغییر نام مدل‌ها، اینجا عوض کن)
GEMINI_MODEL=gemini-2.5-flash

# آیدی عددی ادمین‌ها، با کاما جدا کن
ADMIN_IDS=123456789

# --- سهمیه و VIP ---
FREE_DAILY_LIMIT=5
VIP_DAYS=30

# --- عضویت اجباری (اختیاری): ربات باید در کانال‌ها ادمین باشد ---
# مثال: @MeUnknown_Ir,@another_channel
FORCE_JOIN_CHANNELS=

# --- پرداخت کارت‌به‌کارت برای VIP (اختیاری) ---
CARD_NUMBER=
CARD_HOLDER=
VIP_PRICE=

# --- تنظیمات پیشرفته ---
HISTORY_MESSAGES=6
MAX_INPUT_CHARS=12000
DB_PATH=data/bot.db

# اگر سرور داخل ایران است: پروکسی یا آدرس رله برای تلگرام و Gemini
# PROXY_URL=socks5://127.0.0.1:1080
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
